<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>WhisperDrop</RootNamespace>
    <AssemblyName>ParakeetDrop</AssemblyName>
    <ApplicationTitle>ParakeetDrop</ApplicationTitle>
    <ApplicationId>io.dimonsmart.parakeetdrop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.23.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="8.0.0.1" />
    <PackageReference Include="DevEnvy.FFmpeg.Binaries.LGPL" Version="8.0.1.4" />
  </ItemGroup>

  <ItemGroup>
    <UnoIcon Include="Assets\Icons\icon.png" Resize="true" />
  </ItemGroup>

  <ItemGroup>
    <FfmpegWindowsRuntimeDependency Include="Assets\Ffmpeg\win-x64\*.dll" />
  </ItemGroup>

  <Target Name="CopyBundledParakeetRuntime" AfterTargets="Build;Publish" >
    <ItemGroup>
      <_ParakeetLibrary Include="$(MSBuildProjectDirectory)/../../artifacts/parakeet/osx-arm64/*" />
    </ItemGroup>
    <Error Condition="$([MSBuild]::IsOSPlatform('OSX')) and
                      (!Exists('$(MSBuildProjectDirectory)/../../artifacts/parakeet/osx-arm64/libtranscribe.dylib') or
                       !Exists('$(MSBuildProjectDirectory)/../../artifacts/parakeet/osx-arm64/libggml.0.dylib') or
                       !Exists('$(MSBuildProjectDirectory)/../../artifacts/parakeet/osx-arm64/libggml-base.0.dylib') or
                       !Exists('$(MSBuildProjectDirectory)/../../artifacts/parakeet/osx-arm64/libggml-cpu.so') or
                       !Exists('$(MSBuildProjectDirectory)/../../artifacts/parakeet/osx-arm64/libggml-metal.so'))"
           Text="Build the pinned native runtime first: python3 native/parakeet/build.py" />
    <Copy SourceFiles="@(_ParakeetLibrary)" DestinationFolder="$(OutDir)parakeet/osx-arm64" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ParakeetLibrary)" DestinationFolder="$(PublishDir)parakeet/osx-arm64" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(FfmpegWindowsRuntimeDependency)" DestinationFolder="$(OutDir)ffmpeg/win-x64" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FfmpegWindowsRuntimeDependency)" DestinationFolder="$(PublishDir)ffmpeg/win-x64" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <Content Include="../../THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveBundledFfmpegCliFromOutput" AfterTargets="CopyFFmpegBinaries">
    <ItemGroup>
      <_BundledFfmpegCli Include="$(TargetDir)ffmpeg/**/ffmpeg.exe;$(TargetDir)ffmpeg/**/ffprobe.exe;$(TargetDir)ffmpeg/**/ffmpeg;$(TargetDir)ffmpeg/**/ffprobe" />
    </ItemGroup>
    <Delete Files="@(_BundledFfmpegCli)" />
  </Target>

  <Target Name="RemoveBundledFfmpegCliFromPublish" AfterTargets="PublishFFmpegBinaries">
    <ItemGroup>
      <_PublishedFfmpegCli Include="$(PublishDir)ffmpeg/**/ffmpeg.exe;$(PublishDir)ffmpeg/**/ffprobe.exe;$(PublishDir)ffmpeg/**/ffmpeg;$(PublishDir)ffmpeg/**/ffprobe" />
    </ItemGroup>
    <Delete Files="@(_PublishedFfmpegCli)" />
  </Target>

  <!-- Uno excludes nested native-library directories from the app bundle.
       Copy the matching runtimes into Resources, where AppContext.BaseDirectory
       and the application runtime selectors expect them. -->
  <Target Name="CopyBundledRuntimesToMacOsApp"
          AfterTargets="_UnoPublishAppBundle"
          DependsOnTargets="PublishFFmpegBinaries;CopyBundledParakeetRuntime;RemoveBundledFfmpegCliFromPublish"
          Condition="'$(PackageFormat)' == 'app' and ('$(RuntimeIdentifier)' == 'osx-arm64' )">
    <ItemGroup>
      <_MacAppFfmpegLibrary Include="$(PublishDir)ffmpeg/$(RuntimeIdentifier)/*.dylib" />
      <_MacAppParakeetLibrary Include="$(PublishDir)parakeet/osx-arm64/*" />
    </ItemGroup>
    <Error Condition="'@(_MacAppFfmpegLibrary)' == '' or '@(_MacAppParakeetLibrary)' == ''"
           Text="Native media and Parakeet libraries are required in the macOS app bundle." />
    <Copy SourceFiles="@(_MacAppFfmpegLibrary)" DestinationFolder="$(AppBundlePath)/Contents/Resources/ffmpeg/$(RuntimeIdentifier)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MacAppParakeetLibrary)" DestinationFolder="$(AppBundlePath)/Contents/Resources/parakeet/osx-arm64" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PrepareWindowsRuntimeAppIcon"
          DependsOnTargets="UnoResizetizeImages"
          Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_WindowsRuntimeAppIcon Include="$(AppIconPath)"
                              Condition="'$(AppIconPath)' != '' and Exists('$(AppIconPath)')" />
      <_WindowsRuntimeAppIcon Include="$(IntermediateOutputPath)unoresizetizer\AppIcons\*.ico"
                              Condition="'@(_WindowsRuntimeAppIcon)' == ''" />
    </ItemGroup>
    <Error Condition="'@(_WindowsRuntimeAppIcon)' == ''"
           Text="Uno.Resizetizer did not generate the Windows application icon." />
  </Target>

  <Target Name="CopyWindowsRuntimeAppIconToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="PrepareWindowsRuntimeAppIcon"
          Condition="'$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="@(_WindowsRuntimeAppIcon)"
          DestinationFiles="@(_WindowsRuntimeAppIcon->'$(TargetDir)ParakeetDrop.ico')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWindowsRuntimeAppIconToPublish"
          AfterTargets="Publish"
          DependsOnTargets="PrepareWindowsRuntimeAppIcon"
          Condition="'$(OS)' == 'Windows_NT' and '$(PublishDir)' != ''">
    <Copy SourceFiles="@(_WindowsRuntimeAppIcon)"
          DestinationFiles="@(_WindowsRuntimeAppIcon->'$(PublishDir)ParakeetDrop.ico')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
