<Page
    x:Class="WhisperDrop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpacingMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                <ToggleButton
                    x:Name="TranscribeNavButton"
                    Style="{StaticResource NavigationTabButtonStyle}"
                    Content="Transcribe"
                    IsChecked="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                    Click="TranscribeNav_Click" />
                <ToggleButton
                    x:Name="ModelsNavButton"
                    Style="{StaticResource NavigationTabButtonStyle}"
                    Content="Models"
                    IsChecked="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                    Click="ModelsNav_Click" />
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Application menu"
                AutomationProperties.Name="Application menu">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="About WhisperDrop…" Click="About_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            RowSpacing="{StaticResource SpacingSm}"
            Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="{StaticResource SpacingSm}">
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    FontWeight="SemiBold"
                    Text="TRANSCRIPTION" />

                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Recognition model" />
                        <Grid ColumnSpacing="{StaticResource SpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Style="{StaticResource SettingsComboBoxStyle}"
                                ItemsSource="{x:Bind ViewModel.ModelOptions}"
                                SelectedValue="{x:Bind ViewModel.SelectedModelId, Mode=TwoWay}"
                                SelectedValuePath="Id">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="300" ColumnSpacing="{StaticResource SpacingMd}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{Binding DisplayName}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="{StaticResource SpacingXs}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding InstalledSummary, Converter={StaticResource StringToVisibilityConverter}}">
                                                <FontIcon
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="12"
                                                    Foreground="{StaticResource SuccessBrush}"
                                                    Glyph="&#xE8FB;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource SuccessBrush}"
                                                    Text="{Binding InstalledSummary}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="DownloadSelectedModel_Click"
                                Content="Download"
                                IsEnabled="{x:Bind ViewModel.CanDownloadSelectedModel, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{x:Bind ViewModel.SelectedModelStatus, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Language" />
                        <ComboBox
                            Style="{StaticResource SettingsComboBoxStyle}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                            SelectedValue="{x:Bind ViewModel.RecognitionLanguageCode, Mode=TwoWay}"
                            SelectedValuePath="Code" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Task" />
                        <ComboBox
                            Style="{StaticResource SettingsComboBoxStyle}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.TaskOptions}"
                            SelectedValue="{x:Bind ViewModel.SelectedTranscriptionTask, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Vocabulary / context" />
                        <TextBox
                            Style="{StaticResource SettingsTextBoxStyle}"
                            PlaceholderText="C#, .NET, WhisperDrop..."
                            Text="{x:Bind ViewModel.VocabularyContext, Mode=TwoWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Optional words, names and terms to help recognition." />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource CaptionTextStyle}"
                    FontWeight="SemiBold"
                    Text="PROCESSING" />

                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Voice detection" />
                        <CheckBox
                            x:Name="SkipSilenceCheckBox"
                            Content="Skip silence"
                            IsChecked="{x:Bind ViewModel.SkipSilence, Mode=OneWay}"
                            Click="SkipSilence_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Processing device" />
                        <ComboBox
                            Style="{StaticResource SettingsComboBoxStyle}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.ProcessingDeviceOptions}"
                            SelectedValue="{x:Bind ViewModel.ProcessingDevice, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{x:Bind ViewModel.ProcessingDeviceRestartMessage, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ProcessingDeviceRestartMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <Expander Header="Advanced">
                    <StackPanel
                        Padding="0,8,0,0"
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        Spacing="{StaticResource SpacingXs}">
                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="CPU threads" />
                        <ComboBox
                            Style="{StaticResource SettingsComboBoxStyle}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.CpuThreadOptions}"
                            SelectedValue="{x:Bind ViewModel.CpuThreads, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Border
                x:Name="DropZone"
                Grid.Row="1"
                Style="{StaticResource DropZoneStyle}"
                AllowDrop="True"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource SpacingSm}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Drop audio files here" />
                    <TextBlock
                        x:Name="DropFeedback"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="WAV files only" />
                    <Button
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"
                        ToolTipService.ToolTip="Choose WAV files">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Add files" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Spacing="{StaticResource SpacingXs}">
                <InfoBar
                    x:Name="UnsupportedFormatInfo"
                    IsOpen="False"
                    Severity="Warning" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasTranscriptionGuidance, Mode=OneWay}"
                    Message="{x:Bind ViewModel.TranscriptionGuidance, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>

            <Grid Grid.Row="3" ColumnSpacing="{StaticResource SpacingMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="{x:Bind ViewModel.QueueRows.Count, Mode=OneWay, Converter={StaticResource QueueCountToLabelConverter}}" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingSm}">
                    <Button
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="CopyAll_Click"
                        IsEnabled="{x:Bind ViewModel.CanCopyAll, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy all completed transcripts">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock Text="Copy all" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="TranscribeAll_Click"
                        IsEnabled="{x:Bind ViewModel.CanTranscribeAll, Mode=OneWay}"
                        ToolTipService.ToolTip="Transcribe queued files in order">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Transcribe all" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4">
                <TextBlock
                    x:Name="EmptyState"
                    Margin="2,8,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="No files queued yet." />

                <ListView
                    x:Name="QueueList"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderThickness="0"
                    CanDragItems="{x:Bind ViewModel.CanReorderQueue, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.CanReorderQueue, Mode=OneWay}"
                    DragItemsCompleted="QueueList_DragItemsCompleted"
                    ItemContainerStyle="{StaticResource FileQueueListItemStyle}"
                    ItemsSource="{x:Bind ViewModel.QueueRows}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource FileQueueRowStyle}"
                                ToolTipService.ToolTip="{Binding Preview}">
                                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Width="20"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Glyph="&#xE76F;"
                                        ToolTipService.ToolTip="Drag to reorder" />

                                    <StackPanel Grid.Column="1" MinWidth="0" Spacing="{StaticResource SpacingXs}">
                                        <TextBlock
                                            Style="{StaticResource FileNameTextStyle}"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding FilePath}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding FilePath}" />

                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                Glyph="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}" />
                                            <TextBlock
                                                Style="{StaticResource StatusTextStyle}"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                Text="{Binding Status}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="·" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Language}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Progress}"
                                                Visibility="{Binding Status, Converter={StaticResource StatusEqualsVisibilityConverter}, ConverterParameter=Transcribing}" />
                                        </StackPanel>

                                        <ProgressBar
                                            Height="3"
                                            Maximum="100"
                                            Value="{Binding Progress, Converter={StaticResource ProgressTextToDoubleConverter}}"
                                            Visibility="{Binding Status, Converter={StaticResource StatusEqualsVisibilityConverter}, ConverterParameter=Transcribing}" />

                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{Binding Preview}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Preview, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <TextBlock
                                            MaxLines="2"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding ErrorMessage}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="0,0,4,0"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingXs}"
                                        VerticalAlignment="Center">
                                        <Button
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="Transcribe_Click"
                                            IsEnabled="{Binding CanTranscribe}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Transcribe this file">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <SymbolIcon Symbol="Play" />
                                                <TextBlock Text="Transcribe" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="Copy_Click"
                                            IsEnabled="{Binding CanCopy}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Copy transcript">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <SymbolIcon Symbol="Copy" />
                                                <TextBlock Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource DangerIconButtonStyle}"
                                            Click="RemoveFile_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Remove from queue">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Left"
                Spacing="{StaticResource SpacingMd}">

                <StackPanel Spacing="{StaticResource SpacingXs}">
                    <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Models folder" />
                    <Grid ColumnSpacing="{StaticResource SpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Style="{StaticResource SettingsTextBoxStyle}"
                            Text="{x:Bind ViewModel.ModelsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseModelsFolder_Click"
                            ToolTipService.ToolTip="Choose models folder">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Downloaded models" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingXs}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Disk usage:" />
                        <TextBlock
                            Style="{StaticResource BodyTextStyle}"
                            Text="{x:Bind ViewModel.InstalledModelsSummary, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.InstalledModelsEmptyMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.InstalledModelsEmptyMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                <ListView
                    MaxHeight="360"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource FileQueueListItemStyle}"
                    ItemsSource="{x:Bind ViewModel.InstalledModels}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FileQueueRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel MinWidth="0" Spacing="{StaticResource SpacingXs}">
                                        <TextBlock
                                            Style="{StaticResource FileNameTextStyle}"
                                            Text="{Binding DisplayName}" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingXs}">
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="Size:" />
                                            <TextBlock
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{Binding SizeText}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="·" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteModel_Click"
                                        Content="Delete"
                                        Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DownloadModel_Click"
                        Content="Download model…" />
                    <Button
                        Style="{StaticResource DangerButtonStyle}"
                        Click="DeleteAllModels_Click"
                        Content="Delete all…"
                        IsEnabled="{x:Bind ViewModel.HasInstalledModels, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
