<Page
    x:Class="WhisperDrop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpacingMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource SpacingMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpacingSm}">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Parakeet Ultra Q8_0" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.SelectedModelStatus, Mode=OneWay}" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Click="DownloadSelectedModel_Click"
                        Content="Download model"
                        IsEnabled="{x:Bind ViewModel.CanDownloadSelectedModel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SelectedModelDownloadState, Mode=OneWay, Converter={StaticResource SelectedModelDownloadStateToVisibilityConverter}, ConverterParameter=DownloadAction}" />
            </StackPanel>
            <Button Grid.Column="1" HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Application menu"
                    AutomationProperties.Name="Application menu">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                        <MenuFlyoutItem x:Name="HideToTrayMenuItem" Text="Hide to tray" Click="HideToTray_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="About ParakeetDrop…" Click="About_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            RowSpacing="{StaticResource SpacingSm}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Spacing="{StaticResource SpacingXs}">
                <InfoBar x:Name="UnsupportedFormatInfo" IsOpen="False" Severity="Warning" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasTranscriptionGuidance, Mode=OneWay}"
                    Message="{x:Bind ViewModel.TranscriptionGuidance, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>

            <Grid
                x:Name="FilesToolbar"
                Grid.Row="2"
                ColumnSpacing="{StaticResource SpacingMd}"
                RowSpacing="{StaticResource SpacingSm}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="FilesToolbarWidthStates">
                        <VisualState x:Name="WideFilesToolbar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="760" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="FilesTitle.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="FileActionsPanel.(Grid.Row)" Value="0" />
                                <Setter Target="FileActionsPanel.(Grid.Column)" Value="1" />
                                <Setter Target="FileActionsPanel.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="FileActionsPanel.HorizontalAlignment" Value="Right" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <TextBlock
                    x:Name="FilesTitle"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="{x:Bind ViewModel.QueueRows.Count, Mode=OneWay, Converter={StaticResource QueueCountToLabelConverter}}" />
                <StackPanel
                    x:Name="FileActionsPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingSm}">
                    <Button
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanCancelTranscription, Mode=OneWay}"
                        Click="CancelTranscription_Click" />
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"
                        ToolTipService.ToolTip="Choose audio or video files">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Add files" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Microphone_Click"
                        Content="{x:Bind ViewModel.MicrophoneActionLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanUseMicrophone, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MicrophoneAvailabilityMessage, Mode=OneWay}" />
                    <Button
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="CopyAll_Click"
                        IsEnabled="{x:Bind ViewModel.CanCopyAll, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy all completed transcripts">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock Text="Copy all" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="TranscribeAll_Click"
                        IsEnabled="{x:Bind ViewModel.CanTranscribeAll, Mode=OneWay}"
                        ToolTipService.ToolTip="Transcribe queued files in order">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Transcribe all" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{x:Bind ViewModel.MicrophoneStatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.MicrophoneStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            </Grid>

            <Border
                x:Name="FileQueueWorkspace"
                Grid.Row="3"
                Style="{StaticResource FileQueueWorkspaceStyle}"
                AllowDrop="True"
                DragLeave="FileQueueWorkspace_DragLeave"
                DragOver="FileQueueWorkspace_DragOver"
                Drop="FileQueueWorkspace_Drop">
                <Grid>
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpacingXs}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Drop audio or video files here"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="Common audio and video formats"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                <ListView
                    x:Name="QueueList"
                    AllowDrop="True"
                    DragLeave="FileQueueWorkspace_DragLeave"
                    DragOver="FileQueueWorkspace_DragOver"
                    Drop="FileQueueWorkspace_Drop"
                    Background="Transparent"
                    BorderThickness="0"
                    CanDragItems="{x:Bind ViewModel.CanReorderQueue, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.CanReorderQueue, Mode=OneWay}"
                    DragItemsCompleted="QueueList_DragItemsCompleted"
                    ItemContainerStyle="{StaticResource SelectableFileQueueListItemStyle}"
                    ItemsSource="{x:Bind ViewModel.QueueRows}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource FileQueueRowStyle}"
                                ToolTipService.ToolTip="{Binding Preview}">
                                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Width="20"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Glyph="&#xE76F;"
                                        ToolTipService.ToolTip="Drag to reorder" />

                                    <StackPanel Grid.Column="1" MinWidth="0" Spacing="{StaticResource SpacingXs}">
                                        <TextBlock
                                            Style="{StaticResource FileNameTextStyle}"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding FilePath}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding FilePath}" />

                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                Glyph="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}" />
                                            <TextBlock
                                                Style="{StaticResource StatusTextStyle}"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                Text="{Binding Status}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="·" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Language}" />
                                             <TextBlock Style="{StaticResource CaptionTextStyle}" Text="·" />
                                             <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding SourceLabel}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Progress}"
                                                Visibility="{Binding Status, Converter={StaticResource StatusEqualsVisibilityConverter}, ConverterParameter=Preparing|Transcribing|Improving}" />
                                        </StackPanel>
                                         <TextBlock
                                             Style="{StaticResource CaptionTextStyle}"
                                             Text="{Binding InsertionSummary}"
                                             Visibility="{Binding InsertionSummary, Converter={StaticResource StringToVisibilityConverter}}" />


                                        <ProgressBar
                                            Height="3"
                                            Maximum="100"
                                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                                            Value="{Binding Progress, Converter={StaticResource ProgressTextToDoubleConverter}}"
                                            Visibility="{Binding Status, Converter={StaticResource StatusEqualsVisibilityConverter}, ConverterParameter=Preparing|Transcribing|Improving}" />

                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{Binding Preview}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Preview, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingXs}"
                                            Visibility="{Binding LatestCorrectionBefore, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="AI:" />
                                            <TextBlock
                                                MaxWidth="195"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding LatestCorrectionBefore}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="→" />
                                            <TextBlock
                                                MaxWidth="195"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{Binding LatestCorrectionAfter}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            MaxLines="2"
                                            Foreground="{StaticResource WarningBrush}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding RecognitionWarning}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding RecognitionWarning, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            MaxLines="2"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding ErrorMessage}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            MaxLines="2"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding AiEnhancementError}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding AiEnhancementError, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="0,0,4,0"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingXs}"
                                        VerticalAlignment="Center">
                                        <Button
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="Transcribe_Click"
                                            IsEnabled="{Binding CanTranscribe}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Transcribe this file">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <SymbolIcon Symbol="Play" />
                                                <TextBlock Text="Transcribe" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ImproveTranscript_Click"
                                            Content="{Binding AiActionLabel}"
                                            IsEnabled="{Binding CanEnhance}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Improve the raw Parakeet transcript with the configured AI model" />
                                        <Button
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="CopyAiInput_Click"
                                            IsEnabled="{Binding CanCopyAiInput}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Copy the system instructions and all chunk prompts sent to the AI model">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <SymbolIcon Symbol="Copy" />
                                                <TextBlock Text="AI input" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="PreviewTranscript_Click"
                                            Content="Preview"
                                            IsEnabled="{Binding CanPreviewTranscript}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Open a read-only snapshot of the recognized text" />
                                        <Button
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="Copy_Click"
                                            IsEnabled="{Binding CanCopy}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Copy effective transcript">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <SymbolIcon Symbol="Copy" />
                                                <TextBlock Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="CopyRaw_Click"
                                            Content="Copy raw"
                                            IsEnabled="{Binding CanCopyRaw}"
                                            Tag="{Binding}"
                                            Visibility="{Binding ProcessedTranscript, Converter={StaticResource StringToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Copy the unchanged Parakeet transcript" />
                                        <Button
                                            Style="{StaticResource DangerIconButtonStyle}"
                                            Click="RemoveFile_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Remove from queue">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
