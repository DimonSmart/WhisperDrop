<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FileQueueWorkspaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource FileQueueWorkspacePadding}" />
        <Setter Property="Background" Value="{StaticResource FileQueueWorkspaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLarge}" />
    </Style>

    <Style x:Key="FileQueueRowStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource FileQueueRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource FileQueueRowMargin}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
    </Style>

    <Style x:Key="SettingsPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLarge}" />
    </Style>

    <Style x:Key="StatusPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
    </Style>

    <Style x:Key="FileQueueListItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrongControlBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrongControlBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
    </Style>
</ResourceDictionary>
