<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AppBackgroundColor">#0D1117</Color>
    <Color x:Key="SurfaceColor">#151B23</Color>
    <Color x:Key="SurfaceHoverColor">#1B2430</Color>
    <Color x:Key="ElevatedSurfaceColor">#1A222D</Color>
    <Color x:Key="FileQueueWorkspaceSurfaceColor">#111821</Color>
    <Color x:Key="AccentSubtleColor">#182A43</Color>

    <Color x:Key="PrimaryTextColor">#F3F6FA</Color>
    <Color x:Key="SecondaryTextColor">#A7B1BE</Color>
    <Color x:Key="MutedTextColor">#748091</Color>

    <Color x:Key="BorderColor">#273241</Color>
    <Color x:Key="StrongBorderColor">#3A4A5F</Color>

    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#4B8FF7</Color>
    <Color x:Key="AccentPressedColor">#2F6FD0</Color>

    <Color x:Key="SuccessColor">#4CC38A</Color>
    <Color x:Key="WarningColor">#F0B75A</Color>
    <Color x:Key="ErrorColor">#F06A6A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="FileQueueWorkspaceBackgroundBrush" Color="{StaticResource FileQueueWorkspaceSurfaceColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="StrongControlBorderBrush" Color="{StaticResource StrongBorderColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
</ResourceDictionary>
