<Page
    x:Class="WhisperDrop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpacingMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SettingsSearch"
                 Grid.Row="0"
                 Style="{StaticResource SettingsTextBoxStyle}"
                 PlaceholderText="Search settings by name..."
                 AutomationProperties.Name="Search settings"
                 TextChanged="SettingsSearch_TextChanged" />

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource SpacingMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="{StaticResource SpacingSm}">
                    <ToggleButton x:Name="RecognitionNav" Tag="Recognition" Content="Recognition"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Style="{StaticResource NavigationTabButtonStyle}"
                                  Click="Section_Click" />
                    <ToggleButton x:Name="ModelsNav" Tag="Models" Content="Models &amp; storage"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Style="{StaticResource NavigationTabButtonStyle}"
                                  Click="Section_Click" />
                    <ToggleButton x:Name="DictationNav" Tag="Dictation" Content="Dictation"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Style="{StaticResource NavigationTabButtonStyle}"
                                  Click="Section_Click" />
                    <ToggleButton x:Name="AiNav" Tag="Ai" Content="AI post-processing"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Style="{StaticResource NavigationTabButtonStyle}"
                                  Click="Section_Click" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Padding="{StaticResource SpacingMd}"
                    Background="{StaticResource FileQueueWorkspaceBackgroundBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                <ScrollViewer x:Name="SettingsContentScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch"
                                MaxWidth="720"
                                Spacing="{StaticResource SpacingMd}">
                        <StackPanel x:Name="RecognitionSection" Spacing="{StaticResource SpacingMd}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Recognition" />
                <StackPanel
                    x:Name="RecognitionModelPanel"
                    MinWidth="0"
                    Spacing="{StaticResource SpacingXs}">
                    <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Recognition model" />
                    <Grid ColumnSpacing="{StaticResource SpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            MinWidth="0"
                            Style="{StaticResource SettingsComboBoxStyle}"
                            ItemsSource="{x:Bind ViewModel.ModelOptions}"
                            SelectedValue="{x:Bind ViewModel.SelectedModelId, Mode=TwoWay}"
                            SelectedValuePath="Id">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="0" ColumnSpacing="{StaticResource SpacingMd}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingXs}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding InstalledSummary, Converter={StaticResource StringToVisibilityConverter}}">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource SuccessBrush}"
                                                Glyph="&#xE8FB;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource SuccessBrush}"
                                                Text="{Binding InstalledSummary}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DownloadSelectedModel_Click"
                            Content="Download"
                            IsEnabled="{x:Bind ViewModel.CanDownloadSelectedModel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectedModelDownloadState, Mode=OneWay, Converter={StaticResource SelectedModelDownloadStateToVisibilityConverter}, ConverterParameter=DownloadAction}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{x:Bind ViewModel.SelectedModelStatus, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.SelectedModelDownloadState, Mode=OneWay, Converter={StaticResource SelectedModelDownloadStateToVisibilityConverter}, ConverterParameter=DetailedStatus}" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpacingSm}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Recognition performance" />
                    <Grid ColumnSpacing="{StaticResource SpacingMd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="0" Spacing="{StaticResource SpacingXs}">
                            <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Processing device" />
                            <ComboBox
                                MinWidth="0"
                                Style="{StaticResource SettingsComboBoxStyle}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.ProcessingDeviceOptions}"
                                SelectedValue="{x:Bind ViewModel.ProcessingDevice, Mode=TwoWay}"
                                SelectedValuePath="Value" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{x:Bind ViewModel.ProcessingDeviceReloadMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ProcessingDeviceReloadMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{x:Bind ViewModel.ProcessingBackendStatus, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ProcessingBackendStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" MinWidth="0" Spacing="{StaticResource SpacingXs}">
                            <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="CPU threads" />
                            <ComboBox
                                MinWidth="0"
                                Style="{StaticResource SettingsComboBoxStyle}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.CpuThreadOptions}"
                                SelectedValue="{x:Bind ViewModel.CpuThreads, Mode=TwoWay}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ModelsSection" Spacing="{StaticResource SpacingMd}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Models &amp; storage" />
                <StackPanel Spacing="{StaticResource SpacingXs}">
                    <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Models folder" />
                    <Grid ColumnSpacing="{StaticResource SpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Style="{StaticResource SettingsTextBoxStyle}"
                            IsEnabled="{x:Bind ViewModel.CanChangeModelStorage, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ModelsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanChangeModelStorage, Mode=OneWay}"
                            Click="BrowseModelsFolder_Click"
                            ToolTipService.ToolTip="Choose models folder">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Downloaded models" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingXs}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Disk usage:" />
                        <TextBlock
                            Style="{StaticResource BodyTextStyle}"
                            Text="{x:Bind ViewModel.InstalledModelsSummary, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.InstalledModelsEmptyMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.InstalledModelsEmptyMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                <ListView
                    MaxHeight="360"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource FileQueueListItemStyle}"
                    ItemsSource="{x:Bind ViewModel.InstalledModels}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FileQueueRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel MinWidth="0" Spacing="{StaticResource SpacingXs}">
                                        <TextBlock
                                            Style="{StaticResource FileNameTextStyle}"
                                            Text="{Binding DisplayName}" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingXs}">
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="Size:" />
                                            <TextBlock
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{Binding SizeText}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="·" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteModel_Click"
                                        Content="Delete"
                                        Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DownloadModel_Click"
                        Content="Download model…" />
                    <Button
                        Style="{StaticResource DangerButtonStyle}"
                        Click="DeleteAllModels_Click"
                        Content="Delete all…"
                        IsEnabled="{x:Bind ViewModel.HasInstalledModels, Mode=OneWay}" />
                </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="DictationSection" Spacing="{StaticResource SpacingMd}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Dictation" />
                 <StackPanel Spacing="{StaticResource SpacingSm}">
                     <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Push-to-Talk dictation (Windows)" />
                     <ToggleSwitch Header="Enable background dictation"
                                   IsEnabled="{x:Bind ViewModel.IsWindowsDictationSupported, Mode=OneWay}"
                                   IsOn="{x:Bind ViewModel.DictationEnabled, Mode=TwoWay}" />
                     <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Hold shortcut to record" />
                     <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                              IsEnabled="{x:Bind ViewModel.IsWindowsDictationSupported, Mode=OneWay}"
                              Text="{x:Bind ViewModel.DictationHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                     <ToggleSwitch Header="Insert text into the original field after recognition"
                                   IsEnabled="{x:Bind ViewModel.IsWindowsDictationSupported, Mode=OneWay}"
                                   IsOn="{x:Bind ViewModel.DictationInsertAfterRecognition, Mode=TwoWay}" />
                     <TextBlock Style="{StaticResource CaptionTextStyle}"
                                Text="The recording indicator is always visible above other windows while the microphone is active."
                                TextWrapping="Wrap" />
                     <TextBlock Style="{StaticResource CaptionTextStyle}"
                                Text="{x:Bind ViewModel.DictationStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                 </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="AiSection" Spacing="{StaticResource SpacingMd}">
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="AI post-processing" />
                <CheckBox
                    Content="Improve transcript with AI"
                    IsChecked="{x:Bind ViewModel.AiPostProcessingEnabled, Mode=TwoWay}" />

                <StackPanel Spacing="{StaticResource SpacingXs}">
                    <TextBlock
                        Style="{StaticResource SettingsLabelTextStyle}"
                        Text="Custom correction instructions (not active yet)" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="The current correction pass uses built-in conservative rules only. Saved custom instructions are retained but not sent to the AI model."
                        TextWrapping="Wrap" />
                    <TextBox
                        MinHeight="90"
                        AcceptsReturn="True"
                        IsEnabled="False"
                        TextWrapping="Wrap"
                        Style="{StaticResource SettingsTextBoxStyle}"
                        Text="{x:Bind ViewModel.AiInstructions, Mode=OneWay}" />
                </StackPanel>

                <Expander Header="Technical settings">
                    <StackPanel
                        Padding="0,8,0,0"
                        Spacing="{StaticResource SpacingSm}">
                        <Grid ColumnSpacing="{StaticResource SpacingMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource SpacingXs}">
                                <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Provider" />
                                <ComboBox
                                    Style="{StaticResource SettingsComboBoxStyle}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.AiProviderOptions}"
                                    SelectedValue="{x:Bind ViewModel.AiProvider, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                                <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Model" />
                                <TextBox
                                    Style="{StaticResource SettingsTextBoxStyle}"
                                    Text="{x:Bind ViewModel.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="{StaticResource SpacingXs}">
                            <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Endpoint" />
                            <TextBox
                                Style="{StaticResource SettingsTextBoxStyle}"
                                Text="{x:Bind ViewModel.AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Foreground="{StaticResource WarningBrush}"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{x:Bind ViewModel.AiRemoteEndpointWarning, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.AiRemoteEndpointWarning, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <Grid ColumnSpacing="{StaticResource SpacingMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource SpacingXs}">
                                <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="API key" />
                                <PasswordBox
                                    Password="{x:Bind ViewModel.AiApiKey, Mode=TwoWay}"
                                    PlaceholderText="Required by custom endpoints" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="Not saved between application launches." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                                <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="Context size" />
                                <ComboBox
                                    Style="{StaticResource SettingsComboBoxStyle}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.AiContextSizeOptions}"
                                    SelectedValue="{x:Bind ViewModel.AiContextSize, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="Used only for chunk planning." />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <Button
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="TestAiConnection_Click"
                                Content="Test connection" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.AiConnectionStatus, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.AiConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
